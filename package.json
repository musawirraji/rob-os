{
  "name": "rob-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/shared/interfaces/database.types.ts",
    "seed:ingest": "tsx --conditions=react-server scripts/ingest-seed.ts",
    "ask:test": "tsx --conditions=react-server scripts/ask-acceptance.ts",
    "verify": "tsx --conditions=react-server scripts/verify-engine.ts",
    "db:bundle": "bash scripts/bundle-migrations.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.102.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
